ARRAY numbers = [2, 4, 6, 8, 10];
INTEGER target = 8;
INTEGER low = 0;
INTEGER high = 4;
INTEGER mid = 0;
BOOLEAN found = FALSE;

WHILE (low <= high AND NOT found) {
    mid = (low + high) DIV 2;
    IF (numbers[mid] == target) {
        found = TRUE;
        OUTPUT "Found at index ", mid;
    } ELSE IF (numbers[mid] < target) {
        low = mid + 1;
    } ELSE {
        high = mid - 1;
    }
}
IF (NOT found) { OUTPUT "Not found"; }
